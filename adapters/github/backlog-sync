#!/bin/sh
# GitHub Issues backlog: each open issue labelled ready is a backlog item. The label
# is a person's permission to build, so an unlabelled issue never reaches the scheduler.
#
# Needs the gh CLI, signed in. Env:
#   NOODLE_GH_LABEL       the label that marks an issue ready (default: ready)
#   NOODLE_GH_DONE_LABEL  label that backlog-done adds (default: shinfactory-done);
#                         open issues carrying it sync as status "done"
#   NOODLE_GH_LIMIT       max open issues to read, ready or not (default: 1000)
#
# A plan is linked by a line in the issue body: "Plan: brain/plans/NN-slug/overview.md".
set -eu

done_label="${NOODLE_GH_DONE_LABEL:-shinfactory-done}"

# gh issue list --label goes through GitHub's search API, whose rate limit is much smaller
# than the normal one and blocked the loops for over a day (#175). List open issues and
# filter by label here.
ready_label="${NOODLE_GH_LABEL:-ready}"

filter='.[]
  | [.labels[].name] as $tags
  | select($tags | any(. == "'"$ready_label"'"))
  | ([(.body // "") | capture("(?m)^Plan:[ \t]*(?<p>[^ \t\r\n]+)") | .p] | first) as $plan
  | {id: (.number | tostring),
     title: .title,
     status: (if ($tags | any(. == "'"$done_label"'")) then "done" else "open" end),
     url: .url,
     description: ((.body // "") | .[0:2000])}
  + (if ($tags | length) > 0 then {tags: $tags} else {} end)
  + (if $plan then {plan: $plan} else {} end)'

gh issue list --state open --limit "${NOODLE_GH_LIMIT:-1000}" \
  --json number,title,labels,body,url --jq "$filter"
